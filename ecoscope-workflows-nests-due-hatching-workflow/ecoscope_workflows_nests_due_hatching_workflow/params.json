        "scatter_opacity",
        "stroked",
        "scatter_line_color",
        "scatter_line_width",
        "tooltip_columns"
      ]
    },
    "ui:order": [
      "workflow_details",
      "er_client",
      "time_range",
      "groupers",
      "base_maps",
      "report_template_path",
      "all_events",
