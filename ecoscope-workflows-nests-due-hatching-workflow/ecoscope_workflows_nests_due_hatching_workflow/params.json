        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": ""
    },
    "nests_layer": {
      "additionalProperties": false,
      "properties": {
        "scatter_radius": {
          "default": 5,
          "description": "Point radius in pixels. Only applies when icons are disabled.",
          "ecoscope:advanced": true,
          "maximum": 50,
          "minimum": 1,
          "title": "Scatter Radius",
          "type": "integer"
        },
        "scatter_opacity": {
          "default": 1.0,
          "description": "Point opacity (0\u20131). Only applies when icons are disabled.",
          "ecoscope:advanced": true,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Scatter Opacity",
          "type": "number"
        },
        "stroked": {
          "default": false,
          "description": "Draw an outline around each point. Helps distinguish overlapping/adjacent points. Only applies when icons are disabled.",
          "ecoscope:advanced": true,
          "title": "Stroked",
          "type": "boolean"
        },
        "scatter_line_color": {
          "default": "#ffffff",
          "description": "Outline color (hex). Only applies when icons are disabled and stroked=True.",
          "ecoscope:advanced": true,
          "title": "Scatter Line Color",
          "type": "string"
        },
        "scatter_line_width": {
          "default": 1.0,
          "description": "Outline width in pixels. Only applies when icons are disabled and stroked=True.",
          "ecoscope:advanced": true,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Scatter Line Width",
          "type": "number"
        },
        "tooltip_columns": {
          "default": [],
          "description": "Columns to show when hovering over a point. Leave empty to show all properties.",
          "items": {
            "type": "string"
          },
          "title": "Tooltip Columns",
          "type": "array"
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    },
